# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard > Project Settings > API.
# `.env.local` is gitignored — never commit real keys.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe in the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — bypasses RLS.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

VERCEL_OIDC_TOKEN=VERCEL_OIDC_TOKEN

# Meta Pixel ID is configured once in `lib/meta-config.ts`.

# Server-only Conversions API access token. Never expose this to client code.
# META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0